diff --git a/src/frontend/startkde/startplasmalogin-wayland.cpp b/src/frontend/startkde/startplasmalogin-wayland.cpp
index 5ddc6e98..a98233ce 100644
--- a/src/frontend/startkde/startplasmalogin-wayland.cpp
+++ b/src/frontend/startkde/startplasmalogin-wayland.cpp
@@ -14,6 +14,9 @@
 #include <QDebug>
 
 #include <QCoreApplication>
+#include <QEventLoop>
+#include <QFileInfo>
+#include <QFileSystemWatcher>
 #include <qdbusservicewatcher.h>
 #include <signal.h>
 
@@ -21,6 +24,16 @@ int main(int argc, char **argv)
 {
     QCoreApplication app(argc, argv);
 
+#ifdef USE_DINIT
+    {
+        const QString runtimeDir = qEnvironmentVariable("XDG_RUNTIME_DIR");
+        const QString bus = runtimeDir + QStringLiteral("/bus");
+        QFileSystemWatcher watcher({runtimeDir});
+        QEventLoop loop;
+        QObject::connect(&watcher, &QFileSystemWatcher::directoryChanged, &loop, [&] { if (QFileInfo::exists(bus)) loop.quit(); });
+        if (!QFileInfo::exists(bus)) loop.exec();
+    }
+#endif
     createConfigDirectory();
     setupCursor(true);
     signal(SIGTERM, sigtermHandler);
@@ -69,6 +82,10 @@ int main(int argc, char **argv)
         return 1;
     };
 
+#ifdef USE_DINIT
+    runSync(QStringLiteral("dinitctl"), QStringList{QStringLiteral("setenv")} + QProcess::systemEnvironment());
+    runSync(QStringLiteral("dinitctl"), {QStringLiteral("start"), QStringLiteral("--no-wait"), QStringLiteral("plasma-login-wayland")});
+#else
     {
         auto msg = QDBusMessage::createMethodCall(QStringLiteral("org.freedesktop.systemd1"),
                                                   QStringLiteral("/org/freedesktop/systemd1"),
@@ -80,12 +97,16 @@ int main(int argc, char **argv)
             qWarning() << "Could not start systemd managed Plasma session:" << reply.error().name() << reply.error().message();
         }
     }
+#endif
 
     // stopped by the sigterm handler
     app.exec();
 
     qDebug() << "stopping";
 
+#ifdef USE_DINIT
+    runSync(QStringLiteral("dinitctl"), {QStringLiteral("stop"), QStringLiteral("plasma-login-wayland")});
+#else
     {
         auto msg = QDBusMessage::createMethodCall(QStringLiteral("org.freedesktop.systemd1"),
                                                   QStringLiteral("/org/freedesktop/systemd1"),
@@ -97,11 +118,15 @@ int main(int argc, char **argv)
             qWarning() << "Could not stop systemd managed Plasma session:" << reply.error().name() << reply.error().message();
         }
     }
+#endif
 
     qDebug() << "final cleanup";
 
     // systemd returns when the call is made, but not all jobs are torn down
     // this waits until kwin is definitely gone too, which helps logind
+#ifdef USE_DINIT
+    runSync(QStringLiteral("dinitctl"), {QStringLiteral("stop"), QStringLiteral("plasma-login-kwin_wayland")});
+#else
     {
         auto msg = QDBusMessage::createMethodCall(QStringLiteral("org.freedesktop.systemd1"),
                                                   QStringLiteral("/org/freedesktop/systemd1"),
@@ -113,6 +138,7 @@ int main(int argc, char **argv)
             qWarning() << "Could not close up systemd managed Plasma session:" << reply.error().name() << reply.error().message();
         }
     }
+#endif
 
     return 0;
 }
